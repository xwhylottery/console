-- 📄 Копировать
btnCopy.MouseButton1Click:Connect(function()
    local lines = {}
    for _, e in ipairs(logs) do
        if matchesFilter(e) then
            local prefix = "[info]"
            if e.level == "error" then prefix = "[ERR ]" end
            if e.level == "warn"  then prefix = "[WARN]" end
            table.insert(lines, "["..e.time.."] "..prefix.." "..e.text)
        end
    end
    local allText = table.concat(lines, "\n")

    local ok = pcall(function()
        if setclipboard then setclipboard(allText)
        elseif writeclipboard then writeclipboard(allText)
        elseif toclipboard then toclipboard(allText)
        else error("no api") end
    end)

    if ok then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Console",
                Text = "✅ Скопировано "..#lines.." строк",
                Duration = 2,
            })
        end)
    else
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Console",
                Text = "❌ Clipboard API нет",
                Duration = 3,
            })
        end)
    end
end)

