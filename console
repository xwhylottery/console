-- ═══════ ЛОГИКА ═══════
local function nowStr()
    local t = os.date("*t")
    return string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
end

local function matchesFilter(entry)
    if entry.level == "error" and not showErrors then return false end
    if entry.level == "warn"  and not showWarns  then return false end
    if entry.level == "info"  and not showInfos  then return false end
    local q = searchBox.Text
    if q and q ~= "" then
        if not string.find(string.lower(entry.text), string.lower(q), 1, true) then
            return false
        end
    end
    return true
end

local rowCache = {}

local function makeRow(entry)
    local row = Instance.new("Frame", scroll)
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 0)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.Active = false
    row.ZIndex = 111

    local color = Color3.fromRGB(220, 220, 220)
    if entry.level == "error" then color = Color3.fromRGB(255, 130, 130) end
    if entry.level == "warn"  then color = Color3.fromRGB(255, 210, 120) end
    if entry.level == "info"  then color = Color3.fromRGB(160, 220, 160) end

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -8, 0, 0)
    lbl.Position = UDim2.fromOffset(4, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text = "["..entry.time.."] "..entry.text
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 11
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.Active = false
    lbl.ZIndex = 112
    rowCache[entry.id] = row
    return row
end

local function updateCounter()
    local e, w, i = 0, 0, 0
    for _, x in ipairs(logs) do
        if x.level == "error" then e = e + 1
        elseif x.level == "warn" then w = w + 1
        else i = i + 1 end
    end
    counterTxt.Text = "🔴 "..e.." | 🟡 "..w.." | 🟢 "..i
end

local function addLog(level, text)
    if destroyed then return end
    local last = logs[#logs]
    if last and last.text == text and last.level == level then
        last.count = (last.count or 1) + 1
        if last.row then
            local l = last.row:FindFirstChildOfClass("TextLabel")
            if l then
                l.Text = "["..last.time.."] ("..last.count.."x) "..text
            end
        end
        return
    end

    nextId = nextId + 1
    local entry = {
        id = nextId, level = level,
        text = tostring(text), time = nowStr(), count = 1,
    }
    table.insert(logs, entry)
    if #logs > MAX_LOGS then
        local removed = table.remove(logs, 1)
        if rowCache[removed.id] then
            rowCache[removed.id]:Destroy()
            rowCache[removed.id] = nil
        end
    end
    entry.row = makeRow(entry)
    updateCounter()
    if autoScroll then
        task.defer(function()
            if scroll and scroll.Parent then
                scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
            end
        end)
    end
end

local function refreshAll()
    if destroyed then return end
    for id, row in pairs(rowCache) do
        row:Destroy()
        rowCache[id] = nil
    end
    for _, e in ipairs(logs) do
        if matchesFilter(e) then
            e.row = makeRow(e)
        end
    end
    updateCounter()
end

